    input id="q" placeholder="사업명, 내용, 요구사항 코드" value="하자"
  div
    label for="inst" "발주 기관"
    input id="inst" placeholder="예: 한국교육학술정보원" value="교육"
  div data-state="open"
    button type="button" aria-expanded="true" data-state="open" aria-controls="radix-_r_1_"
      "상세 조건 "
      svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
