{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api-types": "openapi-typescript openapi.json -o src/lib/api-schema.d.ts",
    "dev": "npm run api-types && next dev --port 8510 --hostname 127.0.0.1",
    "build": "npm run api-types && next build",
    "start": "next start --port 8510 --hostname 127.0.0.1",
    "lint": "npm run api-types && eslint",
    "typecheck": "npm run api-types && tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "openapi-fetch": "^0.17.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
